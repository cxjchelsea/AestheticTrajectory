POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aesthetic_trajectory
REPOSITORY_BACKEND=memory
DATABASE_URL=postgresql+psycopg://aesthetic:aesthetic@127.0.0.1:5432/aesthetic_trajectory
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Auth (V5-A)
AUTH_MODE=dev
SESSION_COOKIE_NAME=aesthetic_session
SESSION_TTL_DAYS=365

# report LLM: mock | ollama | openai
REPORT_LLM_RUNTIME=mock
REPORT_LLM_MODEL=llama3.2
REPORT_LLM_TIMEOUT_SECONDS=120

# image feature runtime (V6-A): mock | disabled | ollama_vision
IMAGE_FEATURE_RUNTIME=mock
IMAGE_FEATURE_MODEL=mock-image-feature-v1
IMAGE_FEATURE_TIMEOUT_SECONDS=120

# music feature runtime (V6-B): metadata_only | text_notes | mock | disabled
MUSIC_FEATURE_RUNTIME=metadata_only

# video feature runtime (V6-C): metadata_only | text_notes | mock | disabled
VIDEO_FEATURE_RUNTIME=metadata_only

# external source runtime: disabled | mock_oauth | mcp_oauth
EXTERNAL_SOURCE_RUNTIME=disabled
EXTERNAL_SOURCE_PROVIDER=demo_notes
EXTERNAL_SOURCE_REQUIRED_SCOPES=read
EXTERNAL_SOURCE_REDIRECT_URI=

CHROMA_ENABLED=false
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# embedding: mock | ollama | openai
EMBEDDING_RUNTIME=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSIONS=8

# ollama (local): ollama pull nomic-embed-text
# EMBEDDING_RUNTIME=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# openai (optional)
# EMBEDDING_RUNTIME=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512
# OPENAI_API_KEY=
